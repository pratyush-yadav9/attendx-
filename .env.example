# AttendX Environment Configuration
PROJECT_NAME="AttendX — Intelligent Attendance & Anti-Proxy System"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://attendx_user:attendx_secure_password@localhost:5432/attendx_db
# For SQLite local development if PostgreSQL is offline:
# DATABASE_URL=sqlite:///./attendx.db

# JWT Authentication
JWT_SECRET_KEY=attendx_super_secret_jwt_key_change_in_production_32bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Dynamic QR Signing and Expiration
QR_SECRET_KEY=attendx_dynamic_qr_signing_key_secret_2026!
QR_EXPIRY_SECONDS=45

# Attendance Policy
DEFAULT_ATTENDANCE_THRESHOLD=75.0

# College Geofence Coordinates (Example: Main Campus)
COLLEGE_LATITUDE=28.6139
COLLEGE_LONGITUDE=77.2090
COLLEGE_RADIUS_METERS=150.0

# Frontend URL (For QR code links and CORS)
FRONTEND_URL=http://localhost:5173

# Redis (Optional cache/temporary store; auto-fallback to in-memory)
REDIS_URL=redis://localhost:6379/0
